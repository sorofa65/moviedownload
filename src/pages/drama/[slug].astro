---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Sidebar from '../../components/Sidebar.astro';
import AdSlot from '../../components/AdSlot.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import movies from '../../data/moviesLoader.js';

export function getStaticPaths() {
  return movies.map((drama) => ({ params: { slug: drama.slug }, props: { drama } }));
}
const { drama } = Astro.props;
const similar = movies.filter((m) => m.slug !== drama.slug && m.category === drama.category).slice(0, 8);
const pageUrl = new URL(`/drama/${drama.slug}/`, Astro.site).toString();
const imageUrl = new URL(drama.posterImage, Astro.site).toString();

const videoSchema = drama.videoEmbedUrl ? {
  "@context":"https://schema.org","@type":"VideoObject","name":drama.title,
  "description":drama.description,"thumbnailUrl":imageUrl,"uploadDate":drama.releaseDate,
  "embedUrl":drama.videoEmbedUrl,"url":pageUrl
} : null;
const seriesSchema = {
  "@context":"https://schema.org","@type":"TVSeries","name":drama.title,
  "description":drama.description,"image":imageUrl,"datePublished":drama.releaseDate,
  "genre":drama.genre,"inLanguage":drama.language,"url":pageUrl,
  "numberOfEpisodes":drama.episodesCount
};
const breadcrumbSchema = {
  "@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
    {"@type":"ListItem","position":1,"name":"Home","item":new URL('/',Astro.site).toString()},
    {"@type":"ListItem","position":2,"name":"Short Drama","item":new URL('/category/short-drama/',Astro.site).toString()},
    {"@type":"ListItem","position":3,"name":drama.title,"item":pageUrl}
  ]
};
---
<Layout title={drama.seoTitle} description={drama.seoDescription}
  ogImage={drama.bannerImage || drama.posterImage} canonicalPath={`/drama/${drama.slug}/`}
  jsonLd={[seriesSchema, ...(videoSchema ? [videoSchema] : []), breadcrumbSchema]}>
  <Header />
  <main class="container layout">
    <div class="main-col">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/category/short-drama/">Short Drama</a><span>›</span><span>{drama.title}</span></nav>
      <header class="head">
        <img class="poster" src={drama.posterImage} alt={`${drama.title} cover`} width="300" height="450" fetchpriority="high" />
        <div class="head-info">
          <p class="eyebrow">SHORT DRAMA</p><h1>{drama.title}</h1>
          <p class="meta">{drama.episodesCount > 1 ? `${drama.episodesCount} episodes` : 'Full video'} · {drama.language}</p>
          <div class="tags">{drama.genre.map((g) => <span class="tag">{g}</span>)}</div>
        </div>
      </header>
      <AdSlot name="inArticleTop" />
      <section class="watch block" id="watch">
        <h2>Watch Full Drama</h2>
        {drama.videoEmbedUrl ? <VideoEmbed url={drama.videoEmbedUrl} title={`${drama.title} — Full Short Drama`} aspectRatio={drama.playerAspectRatio} /> : <p>No video is currently available.</p>}
        <p class="description">{drama.description}</p>
      </section>
      <AdSlot name="inArticleBottom" />
      <section class="block" id="episodes">
        <h2>Series Information</h2>
        <dl class="facts">
          <div><dt>Episodes</dt><dd>{drama.episodesCount}</dd></div>
          <div><dt>Language</dt><dd>{drama.language}</dd></div>
          <div><dt>Genre</dt><dd>{drama.genre.join(', ')}</dd></div>
          {drama.releaseDate && <div><dt>Released</dt><dd>{drama.releaseDate}</dd></div>}
        </dl>
        <p class="rights-note">Video playback is provided through the configured external embed URL. Only publish videos you own or are authorized to embed.</p>
      </section>
      {similar.length > 0 && <section class="block"><h2>More Short Dramas</h2><div class="similar-grid">
        {similar.map((m) => <a class="similar-item" href={`/drama/${m.slug}/`}><img src={m.posterImage} alt={m.title} loading="lazy" decoding="async" /><span>{m.title}</span></a>)}
      </div></section>}
    </div>
    <Sidebar />
  </main>
  <Footer />
</Layout>
<style>
.layout{display:grid;grid-template-columns:1fr 300px;gap:28px;padding:20px 20px 40px}.crumbs{display:flex;gap:8px;flex-wrap:wrap;font-size:.8rem;color:var(--text-soft);margin:8px 0 18px}.crumbs a:hover{color:var(--brand)}
.head{display:flex;gap:20px;align-items:flex-start;margin-bottom:24px}.poster{width:150px;height:225px;object-fit:cover;border-radius:10px;background:var(--bg-soft)}
.eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.08em;color:var(--brand);margin:0 0 6px}h1{margin:0 0 8px;font-size:1.55rem;line-height:1.25}.meta{color:var(--text-soft);margin:0 0 12px}.tags{display:flex;gap:6px;flex-wrap:wrap}.tag{padding:3px 9px;border:1px solid var(--border);border-radius:20px;font-size:.75rem}
.block{margin-bottom:28px}.block h2{font-size:1.1rem;margin:0 0 12px}.description{font-size:1rem;line-height:1.7}
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.facts div{padding:12px;background:var(--bg-soft);border-radius:8px}.facts dt{font-size:.72rem;color:var(--text-soft);text-transform:uppercase}.facts dd{margin:2px 0 0;font-weight:600}.rights-note{font-size:.78rem;color:var(--text-soft)}
.similar-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:12px}.similar-item img{width:100%;aspect-ratio:2/3;object-fit:cover;border-radius:8px;margin-bottom:6px}.similar-item span{font-size:.8rem;line-height:1.3}
@media(max-width:900px){.layout{grid-template-columns:1fr}}@media(max-width:600px){.head{flex-direction:column}.poster{width:120px;height:180px}.facts{grid-template-columns:1fr}}
</style>
