---
import Layout from '../../layouts/Layout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import TelegramPromo from '../../components/TelegramPromo.astro';
import MovieCard from '../../components/MovieCard.astro';
import PeriodicTopAd from '../../components/PeriodicTopAd.astro';
import StickyBottomAd from '../../components/StickyBottomAd.astro';
import ResponsiveAdRails from '../../components/ResponsiveAdRails.astro';
import ActionButtons from '../../components/ActionButtons.astro';
import { getAllMovies, getMovieBySlug } from '../../data/moviesLoader';

export async function getStaticPaths() {
  const movies = await getAllMovies();
  return movies.map((movie) => ({
    params: { slug: movie.slug },
    props: { movie },
  }));
}

const { slug } = Astro.params;
const { movie: initialMovie } = Astro.props;

const movie = initialMovie || (await getMovieBySlug(slug));

if (!movie) {
  return Astro.redirect('/404');
}

const allMovies = await getAllMovies();
const relatedMovies = allMovies
  .filter((m) => m.slug !== movie.slug)
  .slice(0, 6);

// uploadDate কে অটোমেটিক Timezone সহ ISO 8601 ফরম্যাটে ফিক্স করার ফাংশন
function getValidIsoDate(dateVal) {
  if (!dateVal) return new Date().toISOString();
  let str = String(dateVal).trim();
  
  // যদি শুধু YYYY-MM-DD থাকে (যেমন: 2026-09-20)
  if (/^\d{4}-\d{2}-\d{2}$/.test(str)) {
    return `${str}T00:00:00Z`;
  }
  
  try {
    const d = new Date(str);
    if (!isNaN(d.getTime())) {
      return d.toISOString();
    }
  } catch (e) {}
  
  return new Date().toISOString();
}

const formattedUploadDate = getValidIsoDate(movie.uploadDate || movie.publishedAt || movie.date);

// Google Search Console এর জন্য শোধন করা VideoObject Schema
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": movie.title || movie.name,
  "description": movie.description || movie.summary || movie.title,
  "thumbnailUrl": [movie.thumbnailUrl || movie.image || movie.poster],
  "uploadDate": formattedUploadDate,
  "embedUrl": movie.embedUrl || movie.videoUrl,
  "url": Astro.url.href
};

// BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${Astro.url.origin}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Short Drama",
      "item": `${Astro.url.origin}/category/short-drama/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": movie.title || movie.name,
      "item": Astro.url.href
    }
  ]
};
---

<Layout title={movie.title} description={movie.description}>
  {/* Structured Data Scripts with Timezone Fixed */}
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  
  <ResponsiveAdRails />
  <PeriodicTopAd />

  <main class="container mx-auto px-4 py-8 max-w-5xl">
    <article class="bg-gray-900 rounded-lg p-6 shadow-xl border border-gray-800">
      <h1 class="text-2xl md:text-4xl font-bold mb-4 text-white">
        {movie.title}
      </h1>

      <div class="mb-6">
        <VideoEmbed embedUrl={movie.embedUrl} title={movie.title} />
      </div>

      <ActionButtons movie={movie} />

      <div class="mt-6 text-gray-300 leading-relaxed">
        <h2 class="text-xl font-semibold mb-2 text-white">Synopsis / Overview</h2>
        <p>{movie.description}</p>
      </div>

      <TelegramPromo />
    </article>

    {relatedMovies.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold mb-6 text-white">You Might Also Like</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
          {relatedMovies.map((relMovie) => (
            <MovieCard movie={relMovie} />
          ))}
        </div>
      </section>
    )}
  </main>

  <StickyBottomAd />
</Layout>
