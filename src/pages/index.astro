---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MovieCard from '../components/MovieCard.astro';
import Sidebar from '../components/Sidebar.astro';
import AdSlot from '../components/AdSlot.astro';
import site from '../data/site.json';
import ads from '../data/ads.json';
import movies from '../data/moviesLoader.js';

const sorted = [...movies].sort((a, b) => new Date(b.releaseDate).getTime() - new Date(a.releaseDate).getTime());
const featured = sorted.slice(0, 5);
const freq = ads.slots.homeBetweenRows?.frequency || 8;
---
<Layout canonicalPath="/">
  <Header />
  <AdSlot name="headerBanner" />

  <main class="container layout">
    <div class="main-col">
      {featured.length > 0 && (
        <section class="featured">
          <div class="feat-strip">
            {featured.map((m) => (
              <a class="feat-item" href={`/movie/${m.slug}/`}>
                <img src={m.bannerImage} alt={m.title} loading="lazy" />
                <div class="feat-overlay">
                  <span class="feat-title">{m.title}</span>
                  <span class="feat-year">{m.year}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="section-block">
        <h2 class="section-title">Latest Movies</h2>
        <div class="grid">
          {sorted.map((movie, i) => (
            <>
              <MovieCard movie={movie} />
              {(i + 1) % freq === 0 && (
                <div class="grid-ad"><AdSlot name="homeBetweenRows" /></div>
              )}
            </>
          ))}
        </div>
      </section>
    </div>

    <Sidebar />
  </main>

  <AdSlot name="footerBanner" />
  <Footer />
</Layout>

<style>
  .layout { display: grid; grid-template-columns: 1fr 300px; gap: 28px; padding: 24px 20px 40px; }
  .feat-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-bottom: 30px; }
  .feat-item { position: relative; display: block; border-radius: var(--radius); overflow: hidden; aspect-ratio: 16/9; background: var(--bg-soft); }
  .feat-item img { width: 100%; height: 100%; object-fit: cover; }
  .feat-overlay {
    position: absolute; left: 0; right: 0; bottom: 0;
    background: linear-gradient(transparent, rgba(0,0,0,.65));
    color: #fff; padding: 10px 12px; display: flex; justify-content: space-between; align-items: flex-end;
  }
  .feat-title { font-weight: 700; font-size: .85rem; }
  .feat-year { font-size: .72rem; opacity: .85; }
  .section-title {
    font-size: 1.15rem; margin: 0 0 16px; padding-left: 10px;
    border-left: 4px solid var(--brand);
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; }
  .grid-ad { grid-column: 1 / -1; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
</style>
