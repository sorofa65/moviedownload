---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MovieCard from '../components/MovieCard.astro';
import DramaCard from '../components/DramaCard.astro';
import Sidebar from '../components/Sidebar.astro';
import AdSlot from '../components/AdSlot.astro';
import movies from '../data/moviesLoader.js';
import dramas from '../data/dramasLoader.js';

const sorted = [...movies].sort((a, b) => new Date(b.releaseDate || 0).getTime() - new Date(a.releaseDate || 0).getTime());
const featured = sorted.slice(0, 6);

// New Drama row — the episode-based system, newest updated first, new ones pinned to front.
const newDramas = [...dramas].sort((a, b) => Number(b.isNew) - Number(a.isNew)).slice(0, 10);

// Watch Now Free row — free episode-dramas first, topped up with the (already free
// to watch) short-drama movies so the row never looks empty on a fresh install.
const freeDramas = dramas.filter((d) => d.isFree);
const freeMovies = sorted.filter((m) => !freeDramas.some((d) => d.slug === m.slug)).slice(0, Math.max(0, 10 - freeDramas.length));
---
<Layout canonicalPath="/">
  <Header />
  <AdSlot name="headerBanner" />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 layout-grid">
    <div class="main-col">

      <!-- Hero -->
      <section class="pt-6 pb-4">
        <p class="text-brand text-xs font-extrabold tracking-widest uppercase">Vertical Drama Hub</p>
        <h1 class="mt-1 text-2xl sm:text-3xl font-extrabold text-gray-900">Watch Short Drama & Full Episode Series</h1>
        <p class="mt-1.5 text-sm text-gray-500 max-w-2xl">New multi-episode drama series and full short-drama videos, all in one place — free to watch, updated regularly.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/series/" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-gray-900 text-white hover:bg-black">🔥 New Drama</a>
          <a href="/series/#free" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 hover:border-brand hover:text-brand">✅ Watch Now Free</a>
          <a href="/category/short-drama/" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 hover:border-brand hover:text-brand">🎬 Latest Drama</a>
        </div>
      </section>

      <!-- New Drama -->
      {newDramas.length > 0 && (
        <section class="mb-8" aria-label="New drama">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-base sm:text-lg font-bold text-gray-900 border-l-4 border-brand pl-2.5">🔥 New Drama</h2>
            <a href="/series/" class="text-xs font-semibold text-brand hover:underline">See all ›</a>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
            {newDramas.map((d) => <DramaCard drama={d} />)}
          </div>
        </section>
      )}

      <AdSlot name="homeBetweenRows" />

      <!-- Watch Now Free -->
      {(freeDramas.length > 0 || freeMovies.length > 0) && (
        <section class="mb-8" aria-label="Watch now free">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-base sm:text-lg font-bold text-gray-900 border-l-4 border-emerald-500 pl-2.5">✅ Watch Now Free</h2>
            <a href="/series/#free" class="text-xs font-semibold text-brand hover:underline">See all ›</a>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
            {freeDramas.map((d) => <DramaCard drama={d} />)}
            {freeMovies.map((m) => <MovieCard movie={m} />)}
          </div>
        </section>
      )}

      <!-- Original featured short-drama banners (unchanged) -->
      {featured.length > 0 && (
        <section class="featured" aria-label="Featured short dramas">
          {featured.map((m) => (
            <a class="feat-item" href={`/drama/${m.slug}/`}>
              <img src={m.bannerImage || m.posterImage} alt={m.title} width="640" height="360" fetchpriority="high" />
              <div class="feat-overlay"><strong>{m.title}</strong><span>{m.episodesCount > 1 ? `${m.episodesCount} episodes` : 'Full video'}</span></div>
            </a>
          ))}
        </section>
      )}

      <!-- Original Latest Drama grid (unchanged, same data + same cards as before) -->
      <section class="section-block" aria-label="Latest drama">
        <h2 class="section-title">🎬 Latest Drama</h2>
        <div class="grid">{sorted.map((movie) => <MovieCard movie={movie} />)}</div>
      </section>
    </div>
    <Sidebar />
  </main>

  <AdSlot name="footerBanner" />
  <Footer />
</Layout>
<style>
.layout-grid{display:grid;grid-template-columns:1fr 300px;gap:28px;padding-bottom:40px}
.featured{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:30px}.feat-item{position:relative;aspect-ratio:16/9;border-radius:10px;overflow:hidden;background:var(--bg-soft)}.feat-item img{width:100%;height:100%;object-fit:cover}.feat-overlay{position:absolute;inset:auto 0 0;padding:28px 10px 10px;background:linear-gradient(transparent,rgba(0,0,0,.75));color:#fff;display:flex;flex-direction:column;gap:3px}.feat-overlay strong{font-size:.82rem}.feat-overlay span{font-size:.7rem;opacity:.9}
.section-title{font-size:1.15rem;margin:0 0 16px;padding-left:10px;border-left:4px solid var(--brand)}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:16px}
@media(max-width:900px){.layout-grid{grid-template-columns:1fr}}@media(max-width:650px){.featured{grid-template-columns:repeat(2,1fr)}}
</style>
