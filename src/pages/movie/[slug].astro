---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Sidebar from '../../components/Sidebar.astro';
import AdSlot from '../../components/AdSlot.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import movies from '../../data/moviesLoader.js';
import ads from '../../data/ads.json';

export function getStaticPaths() {
  return movies.map((movie) => ({
    params: { slug: movie.slug },
    props: { movie }
  }));
}

const { movie } = Astro.props;
const useInterstitial = ads.adsEnabled && ads.redirectInterstitial.enabled;

const similar = movies
  .filter((m) => m.slug !== movie.slug && m.category === movie.category)
  .slice(0, 6);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": movie.category === 'web-series' ? "TVSeries" : "Movie",
  "name": movie.title,
  "datePublished": movie.releaseDate,
  "genre": movie.genre,
  "inLanguage": movie.language,
  "director": { "@type": "Person", "name": movie.director },
  "actor": movie.cast.map((name) => ({ "@type": "Person", "name": name })),
  "image": new URL(movie.posterImage, Astro.site).toString(),
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": movie.rating,
    "bestRating": "10",
    "ratingCount": 1
  },
  "review": {
    "@type": "Review",
    "reviewBody": movie.review,
    "reviewRating": { "@type": "Rating", "ratingValue": movie.rating, "bestRating": "10" }
  }
};

const screenshots = movie.screenshots || [];
const perLinkAdCode = ads.slots.beforeWatchButton?.code || '';
---
<Layout
  title={movie.seoTitle}
  description={movie.seoDescription}
  ogImage={movie.bannerImage}
  canonicalPath={`/movie/${movie.slug}/`}
  jsonLd={jsonLd}
>
  <Header />

  <main class="container layout">
    <div class="main-col">
      <div class="head">
        <img class="poster" src={movie.posterImage} alt={`${movie.title} poster`} />
        <div class="head-info">
          <h1>{movie.title} ({movie.year})</h1>
          <p class="tagline">{movie.shortDescription}</p>
          <p class="date">{movie.releaseDate}</p>
          <div class="tags">
            {movie.genre.map((g) => (<span class="tag">{g}</span>))}
          </div>
        </div>
      </div>

      <nav class="tabs" aria-label="Movie detail tabs">
        <a href="#info" class="tab active">Info</a>
        <a href="#cast" class="tab">Cast</a>
        <a href="#watch" class="tab">Watch Now</a>
      </nav>

      <AdSlot name="inArticleTop" />

      <section id="info" class="block">
        <h2>{movie.videoEmbedUrl ? 'Official Trailer' : 'Synopsis'}</h2>
        {movie.videoEmbedUrl && (
          <VideoEmbed url={movie.videoEmbedUrl} title={`${movie.title} — Official Video`} />
        )}
        <p>{movie.review}</p>
      </section>

      <AdSlot name="inArticleBottom" />

      <section id="cast" class="block">
        <h2>Cast</h2>
        <p>{movie.cast.join(', ')}</p>
        <p class="director">Director: {movie.director}</p>
      </section>

      <AdSlot name="beforeWatchButton" />

      <section id="watch" class="block">
        <h2>Watch Now (Official Platforms)</h2>
        <table class="watch-table">
          <thead>
            <tr><th>Platform</th><th>Type</th><th>Action</th></tr>
          </thead>
          <tbody>
            {movie.watchLinks.map((w) => (
              <>
                {ads.adsEnabled && w.adEnabled && perLinkAdCode && (
                  <tr class="ad-row">
                    <td colspan="3">
                      <div class="inline-ad">
                        <span class="ad-tag">Advertisement</span>
                        <Fragment set:html={perLinkAdCode} />
                      </div>
                    </td>
                  </tr>
                )}
                <tr>
                  <td>{w.platform}</td>
                  <td>{w.type}</td>
                  <td>
                    <a
                      class="watch-btn"
                      href={useInterstitial ? `/redirect/?to=${encodeURIComponent(w.url)}&platform=${encodeURIComponent(w.platform)}` : w.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Watch Now
                    </a>
                  </td>
                </tr>
              </>
            ))}
          </tbody>
        </table>
        <p class="disclaimer">All links go to official, licensed platforms. We do not host or distribute any video files.</p>
      </section>

      {similar.length > 0 && (
        <section class="block">
          <h2>Similar Titles</h2>
          <div class="similar-grid">
            {similar.map((m) => (
              <a class="similar-item" href={`/movie/${m.slug}/`}>
                <img src={m.posterImage} alt={m.title} loading="lazy" />
                <span>{m.title}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <Sidebar />
  </main>

  <Footer />
</Layout>

<style>
  .layout { display: grid; grid-template-columns: 1fr 300px; gap: 28px; padding: 24px 20px 40px; }
  .head { display: flex; gap: 20px; margin-bottom: 20px; }
  .poster { width: 150px; border-radius: var(--radius); flex-shrink: 0; }
  .head-info h1 { margin: 0 0 6px; font-size: 1.35rem; }
  .tagline { color: var(--text-soft); margin: 0 0 4px; }
  .date { font-size: .82rem; color: var(--text-soft); margin: 0 0 10px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag { background: var(--bg-soft); border: 1px solid var(--border); font-size: .75rem; padding: 3px 9px; border-radius: 20px; color: var(--text-soft); }
  .tabs { display: flex; gap: 4px; border-bottom: 2px solid var(--border); margin-bottom: 20px; }
  .tab { padding: 10px 16px; font-size: .9rem; font-weight: 600; color: var(--text-soft); border-bottom: 2px solid transparent; margin-bottom: -2px; }
  .tab.active, .tab:hover { color: var(--brand); border-color: var(--brand); }
  .block { margin-bottom: 28px; }
  .block h2 { font-size: 1.05rem; margin: 0 0 12px; }
  .director { color: var(--text-soft); font-size: .88rem; }
  .watch-table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .watch-table th, .watch-table td { padding: 12px 14px; text-align: left; border-bottom: 1px solid var(--border); font-size: .9rem; }
  .watch-table th { background: var(--bg-soft); font-weight: 700; color: var(--text-soft); font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }
  .watch-btn { display: inline-block; background: var(--brand); color: #fff; padding: 7px 16px; border-radius: 6px; font-weight: 600; font-size: .85rem; }
  .watch-btn:hover { background: var(--brand-dark); }
  .ad-row td { padding: 8px 14px; background: var(--bg-soft); }
  .inline-ad { text-align: center; }
  .inline-ad .ad-tag { display: block; font-size: .65rem; text-transform: uppercase; color: var(--text-soft); margin-bottom: 4px; }
  .disclaimer { font-size: .8rem; color: var(--text-soft); margin-top: 12px; }
  .similar-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 12px; }
  .similar-item { display: block; }
  .similar-item img { width: 100%; aspect-ratio: 2/3; object-fit: cover; border-radius: 8px; margin-bottom: 6px; }
  .similar-item span { font-size: .8rem; color: var(--text); display: block; line-height: 1.3; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } .head { flex-direction: column; } .poster { width: 130px; } }
</style>
