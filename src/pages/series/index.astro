---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import DramaCard from '../../components/DramaCard.astro';
import dramas from '../../data/dramasLoader.js';

const allTags = [...new Set(dramas.flatMap((d) => d.tags || []))];
---
<Layout title="New Drama — Browse All Series" description="Browse every multi-episode drama series, filter by New, Free or genre tag."
  canonicalPath="/series/">
  <Header />
  <main class="container">
    <div class="dr-page">
      <nav class="dr-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>›</span><span aria-current="page">New Drama</span>
      </nav>
      <h1 class="dr-page-title">New Drama</h1>
      <p class="dr-lead">Episode-by-episode drama series — tap a card, then tap an episode number to start watching.</p>

      <AdSlot name="headerBanner" />

      <div id="filter-bar" class="dr-chips">
        <button type="button" data-filter="all" class="dr-chip is-active">All</button>
        <button type="button" data-filter="new" class="dr-chip">🔥 New</button>
        <button type="button" data-filter="free" class="dr-chip">✅ Free</button>
        {allTags.map((t) => (
          <button type="button" data-filter={`tag:${t}`} class="dr-chip">{t}</button>
        ))}
      </div>

      <div id="drama-grid" class="dr-grid">
        {dramas.map((d) => <DramaCard drama={d} />)}
      </div>
      <p id="empty-state" class="dr-empty dr-hidden">No dramas match this filter yet.</p>
    </div>
  </main>
  <Footer />

  <script is:inline>
    (function () {
      var bar = document.getElementById('filter-bar');
      var cards = Array.prototype.slice.call(document.querySelectorAll('#drama-grid > a'));
      var empty = document.getElementById('empty-state');
      if (!bar) return;

      function apply(filter) {
        var visible = 0;
        cards.forEach(function (card) {
          var tags = (card.getAttribute('data-tags') || '').split(',').filter(Boolean);
          var isNew = card.getAttribute('data-new') === '1';
          var isFree = card.getAttribute('data-free') === '1';
          var match = true;
          if (filter === 'new') match = isNew;
          else if (filter === 'free') match = isFree;
          else if (filter.indexOf('tag:') === 0) match = tags.indexOf(filter.slice(4)) !== -1;
          card.classList.toggle('dr-hidden', !match);
          if (match) visible += 1;
        });
        if (empty) empty.classList.toggle('dr-hidden', visible > 0);
      }

      var chips = Array.prototype.slice.call(bar.querySelectorAll('.dr-chip'));
      function select(chip) {
        chips.forEach(function (c) { c.classList.remove('is-active'); });
        chip.classList.add('is-active');
        apply(chip.getAttribute('data-filter') || 'all');
      }
      chips.forEach(function (chip) { chip.addEventListener('click', function () { select(chip); }); });

      function fromHash() {
        if (location.hash === '#free') {
          var freeChip = bar.querySelector('[data-filter="free"]');
          if (freeChip) select(freeChip);
        }
      }
      fromHash();
      window.addEventListener('hashchange', fromHash);
    })();
  </script>
</Layout>
