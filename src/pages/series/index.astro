---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import DramaCard from '../../components/DramaCard.astro';
import dramas from '../../data/dramasLoader.js';

const allTags = [...new Set(dramas.flatMap((d) => d.tags || []))];
---
<Layout title="New Drama — Browse All Series" description="Browse every multi-episode drama series, filter by New, Free or genre tag."
  canonicalPath="/series/">
  <Header />
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <nav class="text-xs text-gray-500 flex gap-1.5 mb-3" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand">Home</a><span>›</span><span class="text-gray-700">New Drama</span>
    </nav>
    <h1 class="text-xl sm:text-2xl font-bold text-gray-900">New Drama</h1>
    <p class="mt-1 text-sm text-gray-500">Episode-by-episode drama series — tap a card, then tap an episode number to start watching.</p>

    <AdSlot name="headerBanner" />

    <div id="filter-bar" class="mt-4 flex flex-wrap gap-2">
      <button type="button" data-filter="all" class="filter-chip is-active text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-200">All</button>
      <button type="button" data-filter="new" class="filter-chip text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-200">🔥 New</button>
      <button type="button" data-filter="free" class="filter-chip text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-200">✅ Free</button>
      {allTags.map((t) => (
        <button type="button" data-filter={`tag:${t}`} class="filter-chip text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-200">{t}</button>
      ))}
    </div>

    <div id="drama-grid" class="mt-5 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      {dramas.map((d) => <DramaCard drama={d} />)}
    </div>
    <p id="empty-state" class="hidden mt-10 text-center text-sm text-gray-400">No dramas match this filter yet.</p>
  </main>
  <Footer />

  <script>
    (function () {
      const bar = document.getElementById('filter-bar');
      const cards = Array.from(document.querySelectorAll('#drama-grid > a'));
      const empty = document.getElementById('empty-state');
      if (!bar) return;

      function apply(filter) {
        let visible = 0;
        cards.forEach((card) => {
          const tags = (card.getAttribute('data-tags') || '').split(',').filter(Boolean);
          const isNew = card.getAttribute('data-new') === '1';
          const isFree = card.getAttribute('data-free') === '1';
          let match = true;
          if (filter === 'new') match = isNew;
          else if (filter === 'free') match = isFree;
          else if (filter.startsWith('tag:')) match = tags.includes(filter.slice(4));
          card.classList.toggle('hidden', !match);
          if (match) visible += 1;
        });
        empty?.classList.toggle('hidden', visible > 0);
      }

      bar.querySelectorAll('.filter-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          bar.querySelectorAll('.filter-chip').forEach((c) => c.classList.remove('is-active', 'bg-brand', 'text-white', 'border-brand'));
          chip.classList.add('is-active', 'bg-brand', 'text-white', 'border-brand');
          apply(chip.getAttribute('data-filter') || 'all');
        });
      });

      if (location.hash === '#free') {
        const freeChip = bar.querySelector('[data-filter="free"]');
        if (freeChip instanceof HTMLElement) freeChip.click();
      }
    })();
  </script>
</Layout>
