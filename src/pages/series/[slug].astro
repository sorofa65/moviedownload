---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import DramaCard from '../../components/DramaCard.astro';
import dramas from '../../data/dramasLoader.js';
import ads from '../../data/ads.json';

export function getStaticPaths() {
  return dramas.map((drama) => ({ params: { slug: drama.slug }, props: { drama } }));
}

const { drama } = Astro.props;
const similar = dramas.filter((d) => d.slug !== drama.slug).slice(0, 6);

const episodeByNumber = new Map(drama.episodes.map((e) => [e.number, e]));
const episodeNumbers = Array.from({ length: drama.totalEpisodes }, (_, i) => i + 1);
const firstEpisode = drama.firstEpisode;

const pageUrl = new URL(`/series/${drama.slug}/`, Astro.site).toString();
const imageUrl = new URL(drama.posterImage, Astro.site).toString();

const seriesSchema = {
  '@context': 'https://schema.org', '@type': 'TVSeries', name: drama.title,
  description: drama.description, image: imageUrl, datePublished: drama.releaseDate,
  genre: drama.genre, inLanguage: drama.language, url: pageUrl,
  numberOfEpisodes: drama.totalEpisodes
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'New Drama', item: new URL('/series/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: drama.title, item: pageUrl }
  ]
};

// Only what the front-end click handler actually needs — never leak the
// rest of ads.json (other slot codes) into the page source.
const adsConfig = {
  adsEnabled: Boolean(ads.adsEnabled),
  episodeSmartLink: ads.episodeSmartLink || { enabled: false, mode: 'off', openInNewTab: true, code: '' }
};
---
<Layout title={drama.seoTitle} description={drama.seoDescription}
  ogImage={drama.bannerImage || drama.posterImage} canonicalPath={`/series/${drama.slug}/`}
  jsonLd={[seriesSchema, breadcrumbSchema]}>
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <nav class="text-xs text-gray-500 flex flex-wrap gap-1.5 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand">Home</a><span>›</span>
      <a href="/series/" class="hover:text-brand">New Drama</a><span>›</span>
      <span class="text-gray-700">{drama.title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,420px)_1fr] gap-6">

      <!-- LEFT: poster, info, blurb, episode grid -->
      <section class="order-2 lg:order-1">
        <div class="flex gap-4">
          <div class="relative w-28 sm:w-36 shrink-0 rounded-lg overflow-hidden shadow">
            <img src={drama.posterImage} alt={`${drama.title} poster`} width="300" height="450" fetchpriority="high" class="w-full aspect-[2/3] object-cover" />
            {drama.isNew && <span class="absolute top-1.5 left-1.5 bg-brand text-white text-[10px] font-bold px-2 py-0.5 rounded-full">NEW</span>}
          </div>
          <div class="min-w-0">
            <h1 class="text-lg sm:text-xl font-bold text-gray-900 leading-snug">{drama.title}</h1>
            <p class="mt-1 text-sm text-gray-500">
              {drama.totalEpisodes} episodes · {drama.language} · {drama.status === 'completed' ? 'Completed' : 'Ongoing'}
            </p>
            <p class="mt-0.5 text-xs text-gray-400">Updated {drama.updatedAt || drama.releaseDate}</p>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {(drama.tags && drama.tags.length ? drama.tags : drama.genre).map((t: string) => (
                <span class="text-[11px] font-medium bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full">{t}</span>
              ))}
            </div>
          </div>
        </div>

        <p class="mt-4 text-sm text-gray-700 leading-relaxed">{drama.description}</p>

        {drama.fullVideoUrl && (
          <div id="full-video-banner" class="mt-4 rounded-xl border-2 border-brand/40 bg-gradient-to-r from-brand/10 via-orange-50 to-brand/10 p-4 transition-shadow">
            <p class="text-sm font-extrabold text-gray-900">
              {drama.releasedCount < drama.totalEpisodes
                ? `⚡ Only ${drama.releasedCount} of ${drama.totalEpisodes} episodes are uploaded here right now.`
                : '⚡ Want the whole series in one go?'}
            </p>
            <p class="mt-1 text-xs text-gray-600">
              {drama.releasedCount < drama.totalEpisodes
                ? 'Watch or download every episode — including the ones not uploaded yet — via our partner link.'
                : 'Watch or download the complete series in one file via our partner link.'}
            </p>
            <a href={drama.fullVideoUrl} target="_blank" rel="noopener noreferrer sponsored"
               class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-white bg-brand hover:bg-brand-dark px-4 py-2 rounded-lg transition-colors shadow-sm">
              ⬇ Get Full Video Now
            </a>
          </div>
        )}

        <AdSlot name="inArticleTop" />

        <div class="mt-5">
          <div class="flex items-center justify-between mb-2">
            <h2 class="text-sm font-bold text-gray-900">Episodes</h2>
            <span id="ep-count-label" class="text-xs text-gray-500">{drama.releasedCount}/{drama.totalEpisodes} released</span>
          </div>
          <div id="episode-grid" class="grid grid-cols-5 sm:grid-cols-6 gap-2">
            {episodeNumbers.map((n) => {
              const ep = episodeByNumber.get(n);
              if (!ep) {
                return (
                  <button type="button"
                    class="soon-btn aspect-square rounded-md border border-dashed border-gray-300 text-gray-400 text-xs font-semibold flex items-center justify-center hover:border-brand hover:text-brand transition-colors"
                    data-ep={n}
                    title="Not uploaded yet — get the full video via the link above"
                  >
                    {n}
                  </button>
                );
              }
              return (
                <button type="button"
                  class="ep-btn aspect-square rounded-md border border-gray-200 text-xs font-semibold flex items-center justify-center transition-colors hover:border-brand hover:text-brand"
                  data-ep={n}
                  data-title={ep.title}
                  data-video={ep.videoUrl}
                  data-locked={ep.locked ? '1' : '0'}
                  data-smart={ep.smartLink}
                >
                  {ep.locked ? '🔒' : n}
                </button>
              );
            })}
          </div>
          {drama.releasedCount < drama.totalEpisodes && (
            <p class="mt-2 text-[11px] text-gray-400">Greyed numbers aren't uploaded yet — tap one, or the banner above, for the full video.</p>
          )}
        </div>

        {similar.length > 0 && (
          <div class="mt-8">
            <h2 class="text-sm font-bold text-gray-900 mb-3">More Dramas</h2>
            <div class="grid grid-cols-3 sm:grid-cols-4 gap-3">
              {similar.map((d) => <DramaCard drama={d} />)}
            </div>
          </div>
        )}
      </section>

      <!-- RIGHT: player -->
      <section class="order-1 lg:order-2">
        <div class="lg:sticky lg:top-20">
          <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
            <span id="now-playing" class="text-sm font-semibold text-gray-800">
              {firstEpisode ? `Now Playing — Episode ${firstEpisode.number}` : 'Coming Soon'}
            </span>
            <div class="flex items-center gap-2">
              <button id="prev-ep" type="button" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-200 text-gray-500 disabled:opacity-40 hover:border-brand hover:text-brand">‹ Previous</button>
              <button id="next-ep" type="button" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-200 text-gray-500 disabled:opacity-40 hover:border-brand hover:text-brand">Next ›</button>
            </div>
          </div>

          <AdSlot name="beforeWatchButton" />

          <div class="relative w-full max-w-md mx-auto lg:mx-0 aspect-[9/16] bg-black rounded-xl overflow-hidden shadow-lg">
            <iframe id="ep-iframe" src={firstEpisode ? firstEpisode.videoUrl : ''} title={`${drama.title} player`}
              class={firstEpisode && !firstEpisode.locked ? 'w-full h-full border-0' : 'w-full h-full border-0 hidden'}
              loading="lazy" allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
              allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>

            <div id="locked-panel"
              class={firstEpisode && firstEpisode.locked ? 'absolute inset-0 flex flex-col items-center justify-center gap-3 bg-gray-900 text-white text-center p-6' : 'absolute inset-0 hidden flex-col items-center justify-center gap-3 bg-gray-900 text-white text-center p-6'}>
              <span class="text-3xl">🔒</span>
              <p class="text-sm text-gray-200">This episode is locked. Continue via our partner link to keep watching.</p>
              <a id="unlock-link" href={drama.fullVideoUrl || '#'} target="_blank" rel="noopener noreferrer sponsored"
                class="mt-1 inline-flex text-sm font-bold bg-brand hover:bg-brand-dark text-white px-5 py-2 rounded-full">
                Unlock Now
              </a>
            </div>

            {!firstEpisode && (
              <div class="absolute inset-0 flex items-center justify-center text-gray-400 text-sm">No episodes uploaded yet.</div>
            )}
          </div>

          <AdSlot name="inArticleBottom" />
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <script type="application/json" id="ads-config" set:html={JSON.stringify(adsConfig)} />
  <script define:vars={{ dramaFullVideoUrl: drama.fullVideoUrl || '' }}>
    (function () {
      const grid = document.getElementById('episode-grid');
      const iframe = document.getElementById('ep-iframe');
      const lockedPanel = document.getElementById('locked-panel');
      const unlockLink = document.getElementById('unlock-link');
      const nowPlaying = document.getElementById('now-playing');
      const prevBtn = document.getElementById('prev-ep');
      const nextBtn = document.getElementById('next-ep');
      if (!grid) return;

      let adsConfig = { adsEnabled: false, episodeSmartLink: { enabled: false, mode: 'off', openInNewTab: true, code: '' } };
      try {
        const raw = document.getElementById('ads-config');
        if (raw) adsConfig = JSON.parse(raw.textContent || '{}');
      } catch (e) { /* keep defaults */ }

      const buttons = Array.from(grid.querySelectorAll('.ep-btn'));

      function openSmartLink(url) {
        if (!url) return;
        const cfg = adsConfig.episodeSmartLink;
        if (!adsConfig.adsEnabled || !cfg || !cfg.enabled) return;
        if (cfg.openInNewTab === false) { window.location.href = url; }
        else { window.open(url, '_blank', 'noopener'); }
      }

      function activate(btn, { fromUserClick }) {
        buttons.forEach((b) => b.classList.remove('bg-brand', 'text-white', 'border-brand'));
        btn.classList.add('bg-brand', 'text-white', 'border-brand');

        const locked = btn.dataset.locked === '1';
        const videoUrl = btn.dataset.video || '';
        const smart = btn.dataset.smart || adsConfig.episodeSmartLink.code || '';
        const epNum = btn.dataset.ep;
        const epTitle = btn.dataset.title || `Episode ${epNum}`;
        const mode = (adsConfig.episodeSmartLink && adsConfig.episodeSmartLink.mode) || 'off';

        if (nowPlaying) nowPlaying.textContent = locked ? `Locked — ${epTitle}` : `Now Playing — ${epTitle}`;

        if (locked || !videoUrl) {
          iframe.classList.add('hidden');
          iframe.src = '';
          lockedPanel.classList.remove('hidden');
          lockedPanel.classList.add('flex');
          if (unlockLink) unlockLink.href = smart || dramaFullVideoUrl || '#';
          if (fromUserClick && (mode === 'lockedOnly' || mode === 'everyClick')) openSmartLink(smart || dramaFullVideoUrl);
        } else {
          lockedPanel.classList.add('hidden');
          lockedPanel.classList.remove('flex');
          iframe.classList.remove('hidden');
          iframe.src = videoUrl;
          if (fromUserClick && mode === 'everyClick') openSmartLink(smart);
        }
        updateNav(btn);
      }

      function updateNav(activeBtn) {
        const idx = buttons.indexOf(activeBtn);
        if (prevBtn) prevBtn.disabled = idx <= 0;
        if (nextBtn) nextBtn.disabled = idx === -1 || idx >= buttons.length - 1;
        prevBtn?.setAttribute('data-idx', String(idx));
        nextBtn?.setAttribute('data-idx', String(idx));
      }

      buttons.forEach((btn) => btn.addEventListener('click', () => activate(btn, { fromUserClick: true })));

      const banner = document.getElementById('full-video-banner');
      const soonButtons = Array.from(grid.querySelectorAll('.soon-btn'));
      soonButtons.forEach((btn) => btn.addEventListener('click', () => {
        if (banner) {
          banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
          banner.classList.add('ring-4', 'ring-brand', 'ring-offset-2');
          setTimeout(() => banner.classList.remove('ring-4', 'ring-brand', 'ring-offset-2'), 1600);
        }
        const cfg = adsConfig.episodeSmartLink;
        if (cfg && (cfg.mode === 'lockedOnly' || cfg.mode === 'everyClick')) {
          openSmartLink(cfg.code || dramaFullVideoUrl);
        }
      }));

      prevBtn?.addEventListener('click', () => {
        const idx = Number(prevBtn.getAttribute('data-idx') || '-1');
        if (idx > 0) activate(buttons[idx - 1], { fromUserClick: false });
      });
      nextBtn?.addEventListener('click', () => {
        const idx = Number(nextBtn.getAttribute('data-idx') || '-1');
        if (idx >= 0 && idx < buttons.length - 1) activate(buttons[idx + 1], { fromUserClick: false });
      });

      if (buttons.length) activate(buttons[0], { fromUserClick: false });
    })();
  </script>
</Layout>
