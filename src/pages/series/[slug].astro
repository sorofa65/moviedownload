---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import DramaCard from '../../components/DramaCard.astro';
import dramas from '../../data/dramasLoader.js';
import ads from '../../data/ads.json';

export function getStaticPaths() {
  return dramas.map((drama) => ({ params: { slug: drama.slug }, props: { drama } }));
}

const { drama } = Astro.props;
const similar = dramas.filter((d) => d.slug !== drama.slug).slice(0, 6);

const episodeByNumber = new Map(drama.episodes.map((e) => [e.number, e]));
const episodeNumbers = Array.from({ length: drama.totalEpisodes }, (_, i) => i + 1);

const pageUrl = new URL(`/series/${drama.slug}/`, Astro.site).toString();
const imageUrl = new URL(drama.posterImage, Astro.site).toString();

// "https://something.example.com/..." is only a placeholder from the sample data —
// never show a dead button to visitors.
const isPlaceholderUrl = (u) => {
  if (!u) return true;
  try { return /(^|\.)example\.(com|org|net)$/.test(new URL(u).hostname.toLowerCase()); }
  catch (e) { return true; }
};
const fullVideoUrl = drama.fullVideoUrl && !isPlaceholderUrl(drama.fullVideoUrl) ? drama.fullVideoUrl : '';
const allReleased = drama.releasedCount >= drama.totalEpisodes;

const seriesSchema = {
  '@context': 'https://schema.org', '@type': 'TVSeries', name: drama.title,
  description: drama.description, image: imageUrl, datePublished: drama.releaseDate,
  genre: drama.genre, inLanguage: drama.language, url: pageUrl,
  numberOfEpisodes: drama.totalEpisodes
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'New Drama', item: new URL('/series/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: drama.title, item: pageUrl }
  ]
};

// Only what the front-end click handler needs — never leak the rest of ads.json
// (other slot codes) into the page source. "<" is escaped so the JSON can never
// close the <script> tag early.
const adsConfig = {
  adsEnabled: Boolean(ads.adsEnabled),
  episodeSmartLink: ads.episodeSmartLink || { enabled: false, mode: 'off', openInNewTab: true, code: '' }
};
const adsConfigJson = JSON.stringify(adsConfig).replace(/</g, '\\u003c');
---
<Layout title={drama.seoTitle} description={drama.seoDescription}
  ogImage={drama.bannerImage || drama.posterImage} canonicalPath={`/series/${drama.slug}/`}
  jsonLd={[seriesSchema, breadcrumbSchema]}>
  <Header />

  <main class="container">
    <div class="dr-page" id="drama-player" data-title={drama.title} data-full-video={fullVideoUrl}>
      <nav class="dr-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>›</span>
        <a href="/series/">New Drama</a><span>›</span>
        <span aria-current="page">{drama.title}</span>
      </nav>

      <div class="dr-watch">

        <!-- LEFT (desktop) / BELOW PLAYER (mobile): poster, info, blurb, episode grid -->
        <section class="dr-watch__info">
          <div class="dr-head">
            <div class="dr-cover">
              <img src={drama.posterImage} alt={`${drama.title} poster`} width="300" height="450" fetchpriority="high" onerror="this.style.display='none'" />
              {drama.isNew && <span class="dr-badge dr-badge--new">NEW</span>}
            </div>
            <div class="dr-head__text">
              <h1 class="dr-title">{drama.title}</h1>
              <p class="dr-meta">
                {drama.totalEpisodes} episodes · {drama.language} · {drama.status === 'completed' ? 'Completed' : 'Ongoing'}
              </p>
              <p class="dr-updated">Updated {drama.updatedAt || drama.releaseDate}</p>
              <div class="dr-tags">
                {(drama.tags && drama.tags.length ? drama.tags : drama.genre).map((t) => (
                  <span class="dr-tag">{t}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="dr-eps-wrap">
            <div class="dr-eps-head">
              <h2>Episodes</h2>
              <span id="ep-count-label" class="dr-eps-count">{drama.releasedCount}/{drama.totalEpisodes} released</span>
            </div>
            <div id="episode-grid" class="dr-eps">
              {episodeNumbers.map((n) => {
                const ep = episodeByNumber.get(n);
                if (!ep) {
                  return (
                    <button type="button" class="dr-ep dr-ep--soon" data-ep={n}
                      aria-label={`Episode ${n} — not uploaded yet`}
                      title="Not uploaded yet — get the full video via the banner below">
                      {n}
                    </button>
                  );
                }
                return (
                  <button type="button" class={ep.locked ? 'dr-ep dr-ep--locked' : 'dr-ep'}
                    data-ep={n}
                    data-title={ep.title}
                    data-video={ep.videoUrl}
                    data-locked={ep.locked ? '1' : '0'}
                    data-smart={ep.smartLink}
                    aria-label={ep.locked ? `Episode ${n} — locked` : `Play episode ${n}`}
                  >
                    {ep.locked ? '🔒' : n}
                  </button>
                );
              })}
            </div>
            <p id="ep-hint" class="dr-eps-hint" role="status" aria-live="polite"></p>
            {!allReleased && (
              <p class="dr-eps-note">Greyed numbers aren't uploaded yet{fullVideoUrl ? ' — tap one, or the banner below, for the full video.' : '.'}</p>
            )}
          </div>

          <p class="dr-desc">{drama.description}</p>

          {fullVideoUrl && (
            <div id="full-video-banner" class="dr-banner">
              <p class="dr-banner__title">
                {allReleased ? '⚡ Want the whole series in one go?' : `⚡ Only ${drama.releasedCount} of ${drama.totalEpisodes} episodes are uploaded here right now.`}
              </p>
              <p class="dr-banner__text">
                {allReleased
                  ? 'Watch or download the complete series in one file via our partner link.'
                  : 'Watch or download every episode — including the ones not uploaded yet — via our partner link.'}
              </p>
              <a href={fullVideoUrl} target="_blank" rel="noopener noreferrer sponsored" class="dr-cta">⬇ Get Full Video Now</a>
            </div>
          )}

          <AdSlot name="inArticleTop" />

          <AdSlot name="inArticleBottom" />

          {similar.length > 0 && (
            <div class="dr-more-block">
              <h2>More Dramas</h2>
              <div class="dr-grid dr-grid--sm">
                {similar.map((d) => <DramaCard drama={d} />)}
              </div>
            </div>
          )}
        </section>

        <!-- RIGHT (desktop) / TOP (mobile): the player -->
        <section class="dr-watch__player">
          <AdSlot name="beforeWatchButton" />
          <div class="dr-sticky">
            <div class="dr-player-bar">
              <span id="now-playing" class="dr-now" aria-live="polite">Loading…</span>
              <div class="dr-nav">
                <button id="prev-ep" type="button" class="dr-navbtn" disabled>‹ Previous</button>
                <button id="next-ep" type="button" class="dr-navbtn" disabled>Next ›</button>
              </div>
            </div>

            <div id="player-wrap" class="dr-player-wrap">
              <div class="dr-player">
                <div id="player-stage" class="dr-player__stage">
                  {drama.episodes.length === 0
                    ? <div class="dr-player__msg"><span class="dr-player__icon">🎬</span><p style="margin:0">No episodes uploaded yet.</p></div>
                    : <div class="dr-player__msg"><span class="dr-player__icon">▶</span><p style="margin:0">Loading player…</p></div>}
                </div>
              </div>
            </div>
            <p id="player-help" class="dr-player-help dr-hidden">Video not loading? <a id="player-open" href="#" target="_blank" rel="noopener noreferrer">Open it in a new tab</a></p>
            <noscript><p class="dr-player-help">Please enable JavaScript to watch the episodes.</p></noscript>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />

  <script type="application/json" id="ads-config" is:inline set:html={adsConfigJson}></script>
  <script is:inline src="/js/episode-player.js?v=2" defer></script>
</Layout>
