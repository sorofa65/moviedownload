---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
---
<Layout title="Disclaimer" canonicalPath="/disclaimer/">
  <Header />
  <main class="container page">
    <h1>Disclaimer</h1>
    <p>{site.name} is an independent review and information website. We do not host, upload, or distribute any copyrighted video, audio, or image files. All "Watch Now" links direct users to official, licensed third-party streaming platforms (e.g. Netflix, Amazon Prime Video, JioCinema). Posters and promotional images are used under fair use for editorial/review purposes.</p>
  </main>
  <Footer />
</Layout>
<style>.page{padding:32px 0 60px;max-width:720px}</style>
