---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MovieCard from '../../components/MovieCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import movies from '../../data/moviesLoader.js';
import site from '../../data/site.json';

export function getStaticPaths() {
  const categories = [...new Set(movies.map((m) => m.category))];
  return categories.map((category) => ({
    params: { category },
    props: { movies: movies.filter((m) => m.category === category) }
  }));
}

const { category } = Astro.params;
const { movies: categoryMovies } = Astro.props;
const label = category.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
---
<Layout
  title={`${label} Movies & Reviews`}
  description={`Latest ${label} movie and series reviews, ratings, and official watch links on ${site.name}.`}
  canonicalPath={`/category/${category}/`}
>
  <Header />
  <main class="container">
    <h1>{label}</h1>
    <AdSlot name="headerBanner" />
    <div class="grid">
      {categoryMovies.map((movie: any) => <MovieCard movie={movie} />)}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  h1 { padding-top: 28px; margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 18px; padding-bottom: 40px; }
</style>
