---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
---
<Layout title="Privacy Policy" canonicalPath="/privacy-policy/">
  <Header />
  <main class="container page">
    <h1>Privacy Policy</h1>
    <p>{site.name} uses cookies and third-party advertising partners to serve ads and measure performance. By using this site you consent to our use of cookies. We do not sell personal data. Replace this placeholder with your full policy before launch.</p>
  </main>
  <Footer />
</Layout>
<style>.page{padding:32px 0 60px;max-width:720px}</style>
