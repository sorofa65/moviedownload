---
export interface Props { drama: any; }
const { drama } = Astro.props;
const freeLabel = drama.isFree ? 'FREE' : `EP 1-${drama.freeEpisodes} FREE`;
---
<a
  href={`/series/${drama.slug}/`}
  class="group block rounded-xl overflow-hidden bg-white border border-gray-200 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-200"
  data-tags={(drama.tags || []).join(',')}
  data-free={drama.isFree ? '1' : '0'}
  data-new={drama.isNew ? '1' : '0'}
>
  <div class="relative aspect-[2/3] bg-gray-100 overflow-hidden">
    <img
      src={drama.posterImage}
      alt={`${drama.title} poster`}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
    />
    <div class="absolute inset-x-0 top-0 flex items-center justify-between p-2">
      {drama.isNew && (
        <span class="bg-brand text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow">NEW</span>
      )}
      <span class="ml-auto bg-black/70 text-white text-[10px] font-semibold px-2 py-0.5 rounded-full">
        {drama.totalEpisodes} EP
      </span>
    </div>
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-2 pt-6 flex items-center justify-between">
      <span class="text-white text-[10px] font-semibold">{drama.status === 'completed' ? 'Completed' : 'Ongoing'}</span>
      <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/90 text-white">{freeLabel}</span>
    </div>
  </div>
  <div class="p-3">
    <h3 class="text-sm font-semibold text-gray-900 leading-snug line-clamp-2 group-hover:text-brand transition-colors">
      {drama.title}
    </h3>
    <p class="mt-1 text-xs text-gray-500 line-clamp-1">{(drama.genre || []).join(' · ')}</p>
  </div>
</a>
