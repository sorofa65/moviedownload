---
// Card for the episode-drama system. Styles live in public/css/dramas.css (.dr-*).
export interface Props { drama: any; }
const { drama } = Astro.props;
const freeLabel = drama.isFree ? 'FREE' : `EP 1-${drama.freeEpisodes} FREE`;
---
<a
  href={`/series/${drama.slug}/`}
  class="dr-card"
  data-tags={(drama.tags || []).join(',')}
  data-free={drama.isFree ? '1' : '0'}
  data-new={drama.isNew ? '1' : '0'}
>
  <div class="dr-poster">
    <span class="dr-poster__fallback" aria-hidden="true">{drama.title}</span>
    <img
      src={drama.posterImage}
      alt={`${drama.title} poster`}
      loading="lazy"
      decoding="async"
      onerror="this.style.display='none'"
    />
    <div class="dr-poster__top">
      {drama.isNew && <span class="dr-badge dr-badge--new">NEW</span>}
      <span class="dr-badge dr-badge--ep">{drama.totalEpisodes} EP</span>
    </div>
    <div class="dr-poster__bottom">
      <span class="dr-status">{drama.status === 'completed' ? 'Completed' : 'Ongoing'}</span>
      <span class="dr-badge dr-badge--free">{freeLabel}</span>
    </div>
  </div>
  <div class="dr-card__info">
    <h3 class="dr-card__title">{drama.title}</h3>
    <p class="dr-card__genre">{(drama.genre || []).join(' · ')}</p>
  </div>
</a>
