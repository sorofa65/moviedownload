---
import site from '../data/site.json';
import movies from '../data/moviesLoader.js';

const latest = [...movies]
  .sort((a, b) => new Date(b.releaseDate).getTime() - new Date(a.releaseDate).getTime())
  .slice(0, 5);

const categories = site.menu.filter((m) => m.href !== '/').map((m) => m.label);
---
<aside class="sidebar">
  <div class="box">
    <h4>Latest Updates</h4>
    <ul class="latest">
      {latest.map((m) => (
        <li>
          <a href={`/movie/${m.slug}/`}>
            <img src={m.posterImage} alt={m.title} loading="lazy" />
            <div>
              <span class="title">{m.title}</span>
              <span class="rating">★ {m.rating}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="box">
    <h4>Categories</h4>
    <ul class="cats">
      {categories.map((c) => (<li><a href={`/category/${c.toLowerCase().replace(/\s+/g, '-')}/`}>› {c}</a></li>))}
    </ul>
  </div>
</aside>

<style>
  .sidebar { display: flex; flex-direction: column; gap: 20px; }
  .box { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }
  .box h4 { margin: 0 0 12px; font-size: .95rem; }
  .latest { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .latest a { display: flex; gap: 10px; align-items: center; }
  .latest img { width: 46px; height: 62px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
  .latest .title { display: block; font-size: .82rem; line-height: 1.3; color: var(--text); }
  .latest .rating { display: block; font-size: .74rem; color: #b8860b; font-weight: 700; margin-top: 2px; }
  .cats { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .cats a { font-size: .85rem; color: var(--text-soft); }
  .cats a:hover { color: var(--brand); }
</style>
