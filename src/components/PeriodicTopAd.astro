---
import ads from '../data/ads.json';
const cfg = ads.periodicTopAd;
const show = ads.adsEnabled && cfg?.enabled && cfg?.code;
---
{show && (
  <div id="periodic-top-ad" class="periodic-top-ad">
    <button id="periodic-top-close" class="close" aria-label="Close ad">&times;</button>
    <span class="ad-tag">Advertisement</span>
    <div id="periodic-top-mount"></div>
  </div>
)}

<script define:vars={{ intervalSeconds: cfg?.intervalSeconds || 45, visibleSeconds: cfg?.visibleSeconds || 8, code: cfg?.code || '' }}>
  const el = document.getElementById('periodic-top-ad');
  if (el) {
    document.getElementById('periodic-top-mount').innerHTML = code;
    let hideTimer;

    const showAd = () => {
      el.classList.add('show');
      clearTimeout(hideTimer);
      hideTimer = setTimeout(() => el.classList.remove('show'), visibleSeconds * 1000);
    };

    setTimeout(showAd, 3000); // first appearance shortly after page load
    setInterval(showAd, intervalSeconds * 1000);

    document.getElementById('periodic-top-close')?.addEventListener('click', () => {
      el.classList.remove('show');
      clearTimeout(hideTimer);
    });
  }
</script>

<style>
  .periodic-top-ad {
    position: fixed; top: 0; left: 0; right: 0; z-index: 160;
    background: #fff; border-bottom: 1px solid var(--border);
    box-shadow: 0 4px 16px rgba(0,0,0,.08);
    padding: 8px 40px 8px 12px; text-align: center;
    transform: translateY(-110%);
    transition: transform .35s ease;
  }
  .periodic-top-ad.show { transform: translateY(0); }
  .close { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: var(--bg-soft); border: 1px solid var(--border); border-radius: 50%; width: 24px; height: 24px; cursor: pointer; color: var(--text-soft); }
  .ad-tag { display: block; font-size: .65rem; text-transform: uppercase; color: var(--text-soft); margin-bottom: 2px; }
</style>
