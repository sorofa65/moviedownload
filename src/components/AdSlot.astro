---
// Renders one ad slot defined in src/data/ads.json.
// Usage: <AdSlot name="sidebar" />
import ads from '../data/ads.json';

export interface Props { name: keyof typeof ads.slots }
const { name } = Astro.props;
const slot = (ads.slots as any)[name];
---
{ads.adsEnabled && slot && slot.enabled && slot.code && (
  <div class="ad-slot" data-ad-slot={name} aria-label="Advertisement">
    <span class="ad-tag">Advertisement</span>
    <Fragment set:html={slot.code} />
  </div>
)}

<style>
  .ad-slot {
    margin: 24px 0;
    padding: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
    overflow: hidden;
  }
  .ad-tag {
    display: block;
    font-size: .68rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-bottom: 6px;
  }
</style>
