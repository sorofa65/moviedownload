---
export interface Props { url: string; title?: string; aspectRatio?: string }
const { url, title = 'Short drama video', aspectRatio = '9/16' } = Astro.props;
---
{url && <div class="video-frame">
  <div class="video-label">Full short drama</div>
  <div class="ratio" style={`aspect-ratio:${aspectRatio.replace('/',' / ')}`}>
    <iframe src={url} title={title} loading="lazy"
      allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
      allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
</div>}
<style>
.video-frame{width:min(100%,520px);margin:0 auto 24px}.video-label{font-size:.8rem;font-weight:700;margin:0 0 8px;color:var(--text-soft)}
.ratio{width:100%;max-height:78vh;border-radius:14px;overflow:hidden;background:#08090b}.ratio iframe{width:100%;height:100%;min-height:420px;border:0;display:block}
@media(max-width:600px){.ratio iframe{min-height:500px}}
</style>
