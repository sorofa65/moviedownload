---
export interface Props { url: string; title?: string }
const { url, title = 'Video' } = Astro.props;
---
{url && (
  <div class="video-frame">
    <span class="live-tag"><i class="dot"></i> Official Video</span>
    <div class="ratio">
      <iframe
        src={url}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>
)}

<style>
  .video-frame {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 10px;
    background: linear-gradient(180deg, #fafbfc, #ffffff);
    box-shadow: 0 6px 20px rgba(0,0,0,.06);
    margin-bottom: 20px;
  }
  .live-tag {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: .72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .04em; color: var(--brand);
    margin: 2px 0 8px 4px;
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); display: inline-block; animation: pulse 1.6s infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
  .ratio {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    background: #0b0c0f;
  }
  .ratio iframe {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    border: 0;
  }
</style>
