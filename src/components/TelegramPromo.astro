---
import ads from '../data/ads.json';
const promo = ads.telegramPromo;
const show = ads.adsEnabled && promo?.enabled;
---
{show && (
  <div id="tg-promo" class="tg-promo" role="dialog" aria-label="Telegram channel join">
    <button id="tg-close" class="tg-close" aria-label="Close">&times;</button>
    <div class="tg-icon">📢</div>
    <h3>{promo.title}</h3>
    <p>{promo.message}</p>
    <div class="tg-channels">
      {promo.channels.map((c) => (
        <a class="tg-btn" href={c.url} target="_blank" rel="noopener noreferrer">{promo.buttonText} — {c.name}</a>
      ))}
    </div>
    <button id="tg-later" class="tg-later">Maybe Later</button>
  </div>
)}

<script define:vars={{ delaySeconds: promo?.delaySeconds || 4, remindAfterHours: promo?.remindAfterHours || 24 }}>
  const KEY = 'tg_promo_dismissed_at';
  const el = document.getElementById('tg-promo');
  if (el) {
    const last = localStorage.getItem(KEY);
    const hoursSince = last ? (Date.now() - parseInt(last, 10)) / 3600000 : Infinity;

    if (hoursSince > remindAfterHours) {
      setTimeout(() => el.classList.add('show'), delaySeconds * 1000);
    }

    const dismiss = () => {
      el.classList.remove('show');
      localStorage.setItem(KEY, Date.now().toString());
    };
    document.getElementById('tg-close')?.addEventListener('click', dismiss);
    document.getElementById('tg-later')?.addEventListener('click', dismiss);
    el.querySelectorAll('.tg-btn').forEach((btn) => btn.addEventListener('click', dismiss));
  }
</script>

<style>
  .tg-promo {
    position: fixed; right: 20px; bottom: 20px; z-index: 200;
    width: 300px; background: #fff; border: 1px solid var(--border);
    border-radius: 14px; padding: 20px; box-shadow: 0 12px 30px rgba(0,0,0,.15);
    opacity: 0; transform: translateY(20px) scale(.96); pointer-events: none;
    transition: opacity .25s ease, transform .25s ease;
  }
  .tg-promo.show { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
  .tg-close { position: absolute; top: 8px; right: 10px; background: none; border: none; font-size: 1.2rem; color: var(--text-soft); cursor: pointer; }
  .tg-icon { font-size: 1.6rem; margin-bottom: 6px; }
  .tg-promo h3 { margin: 0 0 6px; font-size: 1rem; }
  .tg-promo p { margin: 0 0 14px; font-size: .85rem; color: var(--text-soft); }
  .tg-channels { display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; }
  .tg-btn { display: block; text-align: center; background: #229ED9; color: #fff; padding: 10px; border-radius: 8px; font-weight: 700; font-size: .85rem; }
  .tg-btn:hover { background: #1b87bd; }
  .tg-later { width: 100%; background: none; border: none; color: var(--text-soft); font-size: .8rem; cursor: pointer; padding: 4px; }
  @media (max-width: 480px) { .tg-promo { left: 12px; right: 12px; width: auto; } }
</style>
